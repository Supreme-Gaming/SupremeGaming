{
  "name": "ini-notifier-node",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ini-notifier-node/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/ini-notifier-node",
        "main": "apps/ini-notifier-node/src/main.ts",
        "tsConfig": "apps/ini-notifier-node/tsconfig.app.json",
        "assets": ["apps/ini-notifier-node/src/assets", "apps/ini-notifier-node/src/Dockerfile"],
        "generatePackageJson": true,
        "target": "node",
        "compiler": "tsc"
      },
      "configurations": {
        "development": {},
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false,
          "fileReplacements": [
            {
              "replace": "apps/ini-notifier-node/src/environments/environment.ts",
              "with": "apps/ini-notifier-node/src/environments/environment.prod.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "ini-notifier-node:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "ini-notifier-node:build:development"
        },
        "production": {
          "buildTarget": "ini-notifier-node:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/ini-notifier-node/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/ini-notifier-node/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "image-build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker build -t ini-notifier-node ."
          }
        ],
        "cwd": "dist/apps/ini-notifier-node"
      }
    }
  },
  "tags": []
}
