# URL of the remote INI file to monitor (required)
INI_URL=https://example.com/config.ini

# Discord webhook URL to post change notifications (required)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Polling interval in milliseconds (default: 60000)
POLL_INTERVAL_MS=60000

# HTTP request timeout in milliseconds (default: 15000)
REQUEST_TIMEOUT_MS=15000

# Username to display for the webhook (default: ini-notifier)
NOTIFIER_NAME=ini-notifier

# If true, send notifications for changes detected on startup (first run or when cached data differs from remote) (default: false)
NOTIFY_ON_STARTUP=false

# Directory path to store cached INI data on disk (default: ./.cache)
CACHE_DIR=/any/other/path/to/cache

# Title for the Discord embed (default: "INI Changes Detected")
EMBED_TITLE=INI Changes Detected

# Hex color code for the Discord embed (default: ffa500)
EMBED_COLOR=ffa500
